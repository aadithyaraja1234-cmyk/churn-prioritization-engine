# Copy this file to .env and fill in your real key. .env is gitignored -
# never commit the actual key. Powers two independent, both-optional
# features: the Copilot chat (src/copilot/agent.py) and the AI-assisted
# column-mapping suggestion pass during CSV onboarding
# (src/onboarding/ai_mapping.py) - both degrade gracefully if this is
# unset (Copilot shows "unavailable"; mapping falls back to
# name-similarity-only suggestions).
#
# Get a free-tier key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default Gemini model (see src/copilot/agent.py).
# GEMINI_MODEL=gemini-2.5-flash

# REQUIRED before deploying anywhere reachable outside localhost - without
# this, every JWT is signed with a publicly-known dev key (see api/auth.py).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Comma-separated list of extra origins allowed to call this API from a
# browser, on top of the localhost dev defaults - set this to your deployed
# frontend's real URL(s) (see api/main.py).
# On Vercel: your production domain, e.g.
# CORS_ORIGINS=https://your-app.vercel.app
#
# Optional: a regex for platforms with dynamic per-deployment preview URLs
# that CORS_ORIGINS' static list can't enumerate - e.g. a new URL on every
# Vercel preview build. Scope it to your own project, never an open wildcard:
# CORS_ORIGIN_REGEX=https://your-project.*\.vercel\.app

# Optional: point the app at Postgres instead of the default SQLite file
# (see database/db.py and docker-compose.yml's `postgres` service).
# database/db.py normalizes a "postgres://" scheme to "postgresql://"
# automatically, so a connection string pasted straight from a provider's
# dashboard (e.g. Supabase) works with no manual editing. If deploying on
# Render's free tier (a single instance, may cold-start after inactivity),
# prefer Supabase's CONNECTION POOLER string (port 6543, "Transaction" mode
# in the Supabase dashboard) over the direct connection (port 5432) - it
# tolerates the reconnect-after-sleep pattern better.
# DATABASE_URL=postgresql://churn_engine:changeme-in-dot-env@localhost:5432/churn_engine

# Optional: share API-key rate-limit state across multiple backend
# workers/replicas via Redis instead of the default in-process limiter (see
# api/api_keys.py and docker-compose.yml's `redis` service).
# REDIS_URL=redis://localhost:6379/0

# Optional: without this, POST /auth/forgot-password still works but only
# LOGS the reset link (visible to you in server logs, not to the actual
# user) instead of emailing it - see src/notifications/email.py. Get a
# free-tier key (100 emails/day, no card required) at https://resend.com -
# the sandbox sender (onboarding@resend.dev) works immediately with no
# domain setup; verify your own domain later and set RESEND_FROM_ADDRESS
# to switch off it.
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=Churn Engine <onboarding@resend.dev>

# Your deployed frontend's base URL - used to build the link inside the
# password-reset email (e.g. https://your-app.vercel.app/reset-password?
# token=...). Defaults to the local dev frontend if unset.
# FRONTEND_BASE_URL=https://your-app.vercel.app

# Only used if you set DATABASE_URL to the docker-compose postgres service
# above with its default host/db/user - override the password for anything
# beyond local dev.
# POSTGRES_USER=churn_engine
# POSTGRES_PASSWORD=changeme-in-dot-env
# POSTGRES_DB=churn_engine
